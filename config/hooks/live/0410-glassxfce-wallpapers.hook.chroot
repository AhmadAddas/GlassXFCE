#!/bin/sh
set -eu

# Keep the wallpaper chooser focused on the GlassXFCE collection. These are
# stock artwork directories only; the GlassXFCE backgrounds live separately.
rm -rf /usr/share/backgrounds/xfce /usr/share/backgrounds/desktop-base
find /usr/share/images/desktop-base -maxdepth 1 -type f \
  \( -iname '*wallpaper*' -o -iname '*background*' \) -delete 2>/dev/null || true
