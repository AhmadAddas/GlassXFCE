# Debian live/XFCE base
live-task-xfce

# Keep the XFCE pieces GlassXFCE actually uses. We intentionally avoid the
# xfce4-goodies metapackage because it pulls in many panel monitors/utilities
# that are not part of the default GlassXFCE experience.
xfce4-terminal
xfce4-whiskermenu-plugin
xfce4-screenshooter
xfce4-clipman-plugin
xfce4-power-manager
xfce4-docklike-plugin
thunar-archive-plugin
thunar-volman
mate-polkit

# Visual layer
picom
rofi
fonts-inter
plymouth
plymouth-themes
plymouth-label
lightdm
lightdm-gtk-greeter

# Desktop essentials
network-manager-gnome
pipewire-audio
pavucontrol
firefox-esr
gvfs-backends
xdg-utils

# Graphical installer available from the live desktop
calamares
calamares-settings-debian

# Notifications
xfce4-notifyd
libnotify-bin
