# Debian live/XFCE base
live-task-xfce

# Live-session account and privilege setup
# live-config only recommends these packages, while GlassXFCE builds with
# --apt-recommends false. Keep them explicit so the live account is created,
# LightDM can autologin it, and sudo works in the live session.
live-config
live-config-systemd
user-setup
sudo

# Keep the XFCE pieces GlassXFCE actually uses. We intentionally avoid the
# xfce4-goodies metapackage because it pulls in many panel monitors/utilities
# that are not part of the default GlassXFCE experience.
xfce4-terminal
xfce4-whiskermenu-plugin
xfce4-screenshooter
xfce4-clipman-plugin
xfce4-power-manager
xfce4-pulseaudio-plugin
xfce4-docklike-plugin
thunar-archive-plugin
thunar-volman
mate-polkit

# Visual layer
picom
rofi
fonts-inter
plymouth
plymouth-themes
plymouth-label
lightdm
lightdm-gtk-greeter

# Essential amd64 hardware support
# Keep a generic DRM/KMS + X.Org/Mesa path explicit because APT Recommends are
# disabled. xserver-xorg-core provides the modesetting driver; video-all keeps
# AMD/Nouveau/fbdev/VESA/VMware fallbacks, while Mesa supplies 3D/Vulkan.
xserver-xorg-core
xserver-xorg-video-all
libgl1-mesa-dri
mesa-vulkan-drivers

# Firmware coverage for common Intel/AMD/NVIDIA graphics plus networking/audio.
# firmware-misc-nonfree fills smaller kernel-firmware gaps without installing
# proprietary NVIDIA drivers; NVIDIA hardware can use Nouveau in the live image.
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-brcm80211
firmware-amd-graphics
firmware-intel-graphics
firmware-nvidia-graphics
firmware-misc-nonfree
firmware-intel-sound
firmware-sof-signed
intel-microcode
amd64-microcode

# Bluetooth
bluez
blueman

# Desktop essentials
network-manager-gnome
pipewire-audio
pavucontrol
firefox-esr
gvfs-backends
xdg-utils

# Graphical installer available from the live desktop
calamares
calamares-settings-debian

# Notifications
xfce4-notifyd
libnotify-bin
