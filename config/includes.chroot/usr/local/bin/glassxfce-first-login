#!/bin/sh
set -eu

MARKER="$HOME/.config/glassxfce-initialized"
[ -e "$MARKER" ] && exit 0
mkdir -p "$HOME/.config"

# Clean generic Calamares desktop files that may have been copied from an older
# live skeleton. GlassXFCE owns the only installer shortcut shown to users.
rm -f "$HOME/Desktop/calamares-install-debian.desktop" "$HOME/Desktop/install-debian.desktop"

# Disable Xfwm's compositor; Picom supplies compositing instead.
xfconf-query -c xfwm4 -p /general/use_compositing -s false 2>/dev/null || true

# Theme, icons and typography. These names match WhiteSur's default installer names.
xfconf-query -c xsettings -p /Net/ThemeName -n -t string -s "WhiteSur-Light" 2>/dev/null || true
xfconf-query -c xsettings -p /Net/IconThemeName -n -t string -s "WhiteSur" 2>/dev/null || true
xfconf-query -c xsettings -p /Gtk/FontName -n -t string -s "Inter 10" 2>/dev/null || true
xfconf-query -c xfwm4 -p /general/theme -s "WhiteSur-Light" 2>/dev/null || true
# Windows-style controls on the right are the default; users can toggle the side.
xfconf-query -c xfwm4 -p /general/button_layout -n -t string -s "|HMC" 2>/dev/null || true

# Apply the bundled wallpaper to every currently-created workspace/monitor property.
WALL="/usr/share/backgrounds/glassxfce/aurora.svg"
if [ -f "$WALL" ]; then
  xfconf-query -c xfce4-desktop -l 2>/dev/null | while IFS= read -r prop; do
    case "$prop" in
      */last-image) xfconf-query -c xfce4-desktop -p "$prop" -s "$WALL" 2>/dev/null || true ;;
      */image-style) xfconf-query -c xfce4-desktop -p "$prop" -s 5 2>/dev/null || true ;;
    esac
  done
fi

# Spotlight-style application launcher.
xfconf-query -c xfce4-keyboard-shortcuts \
  -p "/commands/custom/<Super>space" -n -t string \
  -s "glassxfce-launcher" 2>/dev/null || true

touch "$MARKER"
