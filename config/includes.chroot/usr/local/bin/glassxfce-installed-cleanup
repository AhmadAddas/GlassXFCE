#!/bin/sh
set -eu

# The live desktop must keep its installer shortcuts.
glassxfce-is-live && exit 0

marker="$HOME/.config/glassxfce-installed-cleanup"
[ -e "$marker" ] && exit 0
mkdir -p "$HOME/.config" "$HOME/.local/share/applications"

rm -f "$HOME/Desktop/install-glassxfce.desktop"
rm -f "$HOME/.config/plank/dock1/launchers/glassxfce-installer.dockitem"

# Shadow the system-wide installer menu entry for installed users.
cat > "$HOME/.local/share/applications/glassxfce-installer.desktop" <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=Install GlassXFCE
Hidden=true
DESKTOP

# Plank notices dockitem removal automatically; leave the rest of the dock untouched.

touch "$marker"
