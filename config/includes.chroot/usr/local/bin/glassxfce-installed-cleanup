#!/bin/sh
set -eu

# The live desktop must keep its installer shortcuts.
glassxfce-is-live && exit 0

marker="$HOME/.config/glassxfce-installed-cleanup"
[ -e "$marker" ] && exit 0
mkdir -p "$HOME/.config" "$HOME/.local/share/applications"

rm -f "$HOME/Desktop/install-glassxfce.desktop"
rm -f "$HOME/.config/xfce4/panel/launcher-25/glass-install.desktop"

# Shadow the system-wide installer menu entry for installed users.
cat > "$HOME/.local/share/applications/glassxfce-installer.desktop" <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=Install GlassXFCE
Hidden=true
DESKTOP

# Remove the installer launcher from the default dock, but leave all other
# pinned launchers and Docklike itself untouched.
if command -v xfconf-query >/dev/null 2>&1; then
  xfconf-query -c xfce4-panel -p /panels/panel-2/plugin-ids -a \
    -t int -s 21 -t int -s 22 -t int -s 23 -t int -s 24 -t int -s 20 \
    2>/dev/null || true
  xfconf-query -c xfce4-panel -p /plugins/plugin-25 -r -R 2>/dev/null || true
  xfce4-panel -r >/dev/null 2>&1 || true
fi

touch "$marker"
