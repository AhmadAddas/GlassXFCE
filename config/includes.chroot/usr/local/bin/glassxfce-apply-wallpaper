#!/bin/sh
set -eu

WALL="/usr/share/backgrounds/glassxfce/silver-wave.png"
[ -r "$WALL" ] || exit 0

set_value() {
  prop="$1"
  type="$2"
  value="$3"
  xfconf-query -c xfce4-desktop -p "$prop" -s "$value" 2>/dev/null || \
    xfconf-query -c xfce4-desktop -p "$prop" -n -t "$type" -s "$value" 2>/dev/null || true
}

apply_base() {
  base="$1"
  set_value "$base/last-image" string "$WALL"
  set_value "$base/image-style" int 5
  set_value "$base/color-style" int 0
  set_value "$base/backdrop-cycle-enable" bool false
}

workspace_count() {
  count="$(xfconf-query -c xfwm4 -p /general/workspace_count 2>/dev/null || printf '%s' 4)"
  case "$count" in
    ''|*[!0-9]*) count=4 ;;
    0) count=1 ;;
  esac
  printf '%s\n' "$count"
}

apply_connected_outputs() {
  outputs="$(xrandr --query 2>/dev/null | awk '$2 == "connected" { print $1 }' || true)"
  [ -n "$outputs" ] || return 1

  count="$(workspace_count)"
  printf '%s\n' "$outputs" | while IFS= read -r output; do
    [ -n "$output" ] || continue
    ws=0
    while [ "$ws" -lt "$count" ]; do
      apply_base "/backdrop/screen0/monitor${output}/workspace${ws}"
      ws=$((ws + 1))
    done
  done

  return 0
}

apply_existing_keys() {
  xfconf-query -c xfce4-desktop -l 2>/dev/null | \
    grep '/workspace[0-9][0-9]*/last-image$' | \
    while IFS= read -r prop; do
      [ -n "$prop" ] || continue
      apply_base "${prop%/last-image}"
    done
}

# Xfdesktop 4.20 creates connector-specific backdrop keys after RandR discovery
# (for example monitorHDMI-1 or monitoreDP-1). Seed those exact keys instead of
# relying on the generic monitor0 skeleton key, which can be ignored on first
# login and leave the desktop black until the user changes the wallpaper once.
i=0
while [ "$i" -lt 24 ]; do
  apply_connected_outputs || true
  apply_existing_keys || true
  i=$((i + 1))
  sleep 1
done

xfdesktop --reload >/dev/null 2>&1 || true
