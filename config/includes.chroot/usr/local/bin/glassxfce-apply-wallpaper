#!/bin/sh
set -eu

WALL="/usr/share/backgrounds/glassxfce/silver-wave.png"
[ -r "$WALL" ] || exit 0

set_value() {
  prop="$1"
  type="$2"
  value="$3"
  xfconf-query -c xfce4-desktop -p "$prop" -s "$value" 2>/dev/null || \
    xfconf-query -c xfce4-desktop -p "$prop" -n -t "$type" -s "$value" 2>/dev/null || true
}

apply_base() {
  base="$1"
  set_value "$base/last-image" string "$WALL"
  set_value "$base/image-style" int 5
  set_value "$base/color-style" int 0
}

# XFCE initially loads the skeleton's generic monitor0 key and then migrates to
# hardware-specific monitor keys after RandR/xfdesktop discovery. Applying only
# once can therefore be overwritten and leave a black desktop until the user
# manually changes the wallpaper. Keep watching briefly and apply to every
# backdrop key that appears during session startup.
i=0
while [ "$i" -lt 24 ]; do
  # Always maintain the generic fallback.
  apply_base "/backdrop/screen0/monitor0/workspace0"

  props="$(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep '/last-image$' || true)"
  if [ -n "$props" ]; then
    printf '%s\n' "$props" | while IFS= read -r prop; do
      [ -n "$prop" ] || continue
      apply_base "${prop%/last-image}"
    done
  fi

  i=$((i + 1))
  sleep 1
done

# One final refresh after monitor migration has settled.
xfdesktop --reload >/dev/null 2>&1 || true
