#!/bin/sh
set -eu

if ! glassxfce-is-live; then
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "GlassXFCE" "The installer is only available in the live session."
  fi
  exit 0
fi

if command -v calamares-install-debian >/dev/null 2>&1; then
  exec calamares-install-debian
fi
exec calamares
