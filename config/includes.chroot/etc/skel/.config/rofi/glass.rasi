* {
    background:     #111827e8;
    background-alt: #ffffff12;
    foreground:     #f7f9ffff;
    muted:          #b9c2d6ff;
    accent:         #8ea8ffff;
    border-color:   #ffffff24;
}

window {
    width: 560px;
    border: 1px;
    border-color: @border-color;
    border-radius: 20px;
    background-color: @background;
    padding: 18px;
}

mainbox {
    spacing: 14px;
    background-color: transparent;
}

inputbar {
    padding: 10px 12px;
    spacing: 10px;
    border-radius: 14px;
    background-color: @background-alt;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    background-color: transparent;
}

entry {
    placeholder: "Search apps";
    placeholder-color: @muted;
    text-color: @foreground;
    background-color: transparent;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: false;
    scrollbar: false;
    spacing: 4px;
    background-color: transparent;
}

element {
    padding: 10px 12px;
    spacing: 12px;
    border-radius: 12px;
    background-color: transparent;
    text-color: @foreground;
}

element selected {
    background-color: @background-alt;
    text-color: @foreground;
}

element-icon {
    size: 28px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}
