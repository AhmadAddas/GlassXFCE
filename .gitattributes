# Normalize text files and use Unix LF endings
* text=auto eol=lf

# Explicit text formats
*.sh        text eol=lf
*.bash      text eol=lf
*.conf      text eol=lf
*.cfg       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.list      text eol=lf
*.desktop   text eol=lf
*.xml       text eol=lf
*.json      text eol=lf
*.css       text eol=lf

# Binary files
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.ico       binary
*.zip       binary
*.iso       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
