# live-build output
.binary
.build
.cache
.chroot
binary*
cache/
chroot/
source/
*.iso
*.img
*.contents
*.packages
*.zsync

dist/

# Generated theme payloads (rebuilt from pinned submodules)
config/includes.chroot/usr/share/themes/WhiteSur*
config/includes.chroot/usr/share/icons/WhiteSur*

# Local wallpaper payload copied during build
config/includes.chroot/usr/share/backgrounds/glassxfce/default.*
!config/includes.chroot/usr/share/backgrounds/glassxfce/README.md

# Generated release identity (created by scripts/stage-identity.sh)
config/includes.chroot/etc/os-release
config/includes.chroot/etc/glassxfce-release
config/includes.chroot/etc/issue
config/includes.chroot/etc/issue.net
